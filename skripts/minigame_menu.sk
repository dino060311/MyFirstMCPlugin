# [미니게임 통합 GUI 메뉴 시스템]
options:
    p: §f[§bMENU§f]
    
command /미니게임:
    trigger:
        # 3줄(27칸) 크기의 Custom GUI 생성
        open chest inventory with 3 rows named "§e§l🎮 미니게임 통합 제어 센터" to player
        
        # 배경 채우기
        set {_slot} to 0
        loop 27 times:
            set slot {_slot} of player's current inventory to gray stained glass pane named "§7"
            add 1 to {_slot}
            
        # 1. 가위바위보 데스매치 버튼
        set slot 10 of player's current inventory to diamond sword named "§6§l가위바위보 데스매치" with lore "§7------------------------", "§f1:1 심리전 PvP 미니게임", "§7------------------------", "", "§e[ 좌클릭 ] §a/가위바위보 명령어 입력창 띄우기", "§e[ 우클릭 ] §f게임 설명 보기"
        
        # 2. 타임어택 낚시 게임 버튼
        set slot 12 of player's current inventory to fishing rod named "§b§l타임어택 낚시 게임" with lore "§7------------------------", "§f실시간 타임어택 낚시게임", "§7------------------------", "", "§e[ 좌클릭 ] §a/낚시게임 즉시 실행", "§e[ 우클릭 ] §f게임 설명 보기"
        
        # 3. 실시간 순발력 테스트 버튼
        set slot 14 of player's current inventory to clock named "§e§l순발력 테스트 미니게임" with lore "§7------------------------", "§f실시간 반응 속도 측정 게임", "§7------------------------", "", "§e[ 좌클릭 ] §a/순발력게임 즉시 실행", "§e[ 우클릭 ] §f게임 설명 보기"
        
        # 4. 럭키 슬롯 머신 버튼
        set slot 16 of player's current inventory to tripwire hook named "§d§l럭키 슬롯 머신" with lore "§7------------------------", "§f황금 코인을 사용하는 카지노 미니게임", "§7------------------------", "", "§e[ 좌클릭 ] §a슬롯머신 패키지 받기 §a§l(코인 1세트 증정!)", "§e[ 우클릭 ] §f게임 설명 보기"
        
        
# GUI 클릭 이벤트 제어
on inventory click:
    if name of player's current inventory is "§e§l🎮 미니게임 통합 제어 센터":
        cancel event # 아이템을 인벤토리에서 꺼내지 못하게 고정
        
        if event-item is a gray stained glass pane:
            stop
            
        # 1. 가위바위보 데스매치 클릭
        if index of event-slot is 10:
            close player's inventory
            if click type is left mouse button:
                send "§7[팁] 대결할 플레이어의 이름을 뒤에 적어주세요! §e(예: /가위바위보 닉네임)" to player
                make player execute command "/가위바위보"
            else if click type is right mouse button:
                send "" to player
                send "§6§l[가위바위보 데스매치] 설명" to player
                send "§f- 상대를 지정해 결투를 신청하고, GUI창에서 가위바위보를 선택합니다." to player
                send "§f- 이긴 사람은 §c날카로운 검§f을, 진 사람은 §9방패§f를 받아 PvP를 진행합니다." to player
                send "" to player
                
        # 2. 타임어택 낚시 게임 클릭
        if index of event-slot is 12:
            close player's inventory
            if click type is left mouse button:
                make player execute command "/낚시게임"
            else if click type is right mouse button:
                send "" to player
                send "§b§l[타임어택 낚시 게임] 설명" to player
                send "§f- 60초의 제한 시간 동안 바다나 물가에서 최대한 많은 물고기를 낚아야 합니다." to player
                send "§f- 대구, 연어, 복어, 열대어 등 낚인 생선의 희귀도에 따라 다른 점수를 획득합니다." to player
                send "§f- 액션바를 통해 실시간으로 남은 시간과 내 점수를 확인하며 경쟁해 보세요!" to player
                send "" to player
                
        # 3. 순발력 테스트 클릭
        if index of event-slot is 14:
            close player's inventory
            if click type is left mouse button:
                make player execute command "/순발력게임"
            else if click type is right mouse button:
                send "" to player
                send "§e§l[순발력 테스트] 설명" to player
                send "§f- 화면에 나타나는 GUI 창 속에서 목표 아이템을 빠르게 찾아 클릭합니다." to player
                send "§f- 실시간으로 플레이어들의 반응 속도를 밀리초(ms) 단위로 정밀 측정합니다." to player
                send "" to player
                
        # 4. 럭키 슬롯 머신 클릭
        if index of event-slot is 16:
            close player's inventory
            if click type is left mouse button:
                # 슬롯머신 기계 아이템이 없으면 패키지 전체 지급
                if player does not have tripwire hook named "§d§l[ 럭키 슬롯 머신 ]":
                    # 1. 슬롯머신 레버 지급
                    give tripwire hook named "§d§l[ 럭키 슬롯 머신 ]" with lore "§7우클릭하여 슬롯머신 열기", "§e비용: 황금 코인 5개" to player
                    
                    # 2. 황금 코인 1세트 동시 지급
                    give 64 of sunflower named "§6§l[ 황금 코인 ]" to player
                    
                    send "{@p} §a[슬롯머신 패키지] §f기계 아이템과 §e황금 코인 64개§f를 지급했습니다!" to player
                    play sound "entity.item.pickup" to player
                else:
                    # 이미 기계가 있다면 유저 편의를 위해 코인만 한 세트 더 보충해 줍니다.
                    give 64 of sunflower named "§6§l[ 황금 코인 ]" to player
                    send "{@p} §e황금 코인 64개§f를 추가로 보충해 드렸습니다!" to player
                    play sound "entity.item.pickup" to player
                    
            else if click type is right mouse button:
                send "" to player
                send "§d§l[럭키 슬롯 머신] 설명" to player
                send "§f- 황금 코인 §e5개§f를 사용하여 슬롯머신을 돌릴 수 있습니다." to player
                send "§f- 석탄, 철괴, 금괴, 에메랄드, 다이아몬드 잭팟이 존재합니다." to player
                send "§f- 희귀한 결과일수록 더 많은 §6황금 코인§f을 획득할 수 있습니다." to player
                send "" to player
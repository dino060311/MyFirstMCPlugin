command /서버명령어:
    trigger:
        send ""
        send "§b§l[ SERVER COMMAND HELP ]"
        send "§7--------------------------------"

        send "§e/마법지팡이 §f: 화염 마법 지팡이 지급"
        send "§e/시한폭탄 §f: 투척형 시한폭탄 지급"

        send "§e/직업선택 §f: 직업 선택 GUI 메뉴"
        send "§e/랜덤직업 §f: 마피아 직업 룰렛 시작"

        send "§e/타이머 §f: 파밍 시간 타이머 시작"
        send "§e/컷신 §f: 화면 고정 컷신 실행"

        send "§e/npc소환 §f: 스토리 NPC 소환"
        send "§e/무기대장장이 §f: 상인 NPC 소환"

        send "§e/보스좀비소환 §f: 보스 좀비 소환"

        send "§e/미니게임 §f: 미니게임 통합 메뉴 열기"
        send "§e/낚시게임 §f: 타임어택 낚시 게임"
        send "§e/순발력게임 §f: 순발력 테스트 시작"
        send "§e/가위바위보 §f: PvP 데스매치 신청"

        send "§7--------------------------------"
        send ""